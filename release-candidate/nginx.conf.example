server {
    listen 80;
    server_name example.ru;            # заменить на домен
    root /var/www/customsleader/site;  # путь к папке site
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml text/plain;

    # файлы с хэшем в имени не меняются: кэш на год
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Страницы: /about отдаётся из pages/about.html и т. д., папка pages/ сама адресом не служит
    error_page 404 /pages/404.html;
    location ^~ /pages/ { rewrite ^/pages/(.+?)(\.html)?$ /$1 permanent; }
    location ~ ^/contacts/Moscow/?$ { return 301 https://customsleader.ru/contacts/moscow; }
    location ~ ^/contacts/Vladimir/?$ { return 301 https://customsleader.ru/contacts/vladimir; }
    location ~* ^/(moscow|vladimir|yaroslavl)/?$ { return 301 https://customsleader.ru/contacts/$1; }

    location / {
        try_files $uri /pages$uri.html =404;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
