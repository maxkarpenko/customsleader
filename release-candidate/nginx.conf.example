server {
    listen 80;
    server_name example.ru;            # заменить на домен
    root /var/www/customsleader/site;  # путь к папке site
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml text/plain;

    # файлы с хэшем в имени не меняются: кэш на год
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Страницы старого сайта: /about отдаётся из about.html и т. д.
    location ~* ^/contacts/moscow/?$ { if ($request_uri !~ ^/contacts/Moscow) { return 301 https://customsleader.ru/contacts/Moscow; } try_files /contacts/Moscow.html =404; }
    location ~* ^/contacts/vladimir/?$ { if ($request_uri !~ ^/contacts/Vladimir) { return 301 https://customsleader.ru/contacts/Vladimir; } try_files /contacts/Vladimir.html =404; }
    location ~* ^/(moscow|vladimir|yaroslavl)/?$ { return 301 https://customsleader.ru/contacts/$1; }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
