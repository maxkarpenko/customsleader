server {
    listen 80;
    server_name example.ru;            # заменить на домен
    root /var/www/customsleader/site;  # путь к папке site
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml text/plain;

    # файлы с хэшем в имени не меняются: кэш на год
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
