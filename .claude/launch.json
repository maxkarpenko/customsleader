{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "single",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "-d",
        "docs"
      ],
      "port": 4180
    },
    {
      "name": "release",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/serve-release.py",
        "4190"
      ],
      "port": 4190
    }
  ]
}