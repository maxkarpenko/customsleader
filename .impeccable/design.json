  "narrative": {
    "northStar": "Graphite photography studio",
    "overview": "A graphite studio gives industrial geometry room to read: silver metal, pale warm type and a safety-orange route. Firm rectangular controls and restrained rounding keep the inquiry interface practical alongside the cinematic illustration.\n\nThis is a code-led React and Three.js system. Procedural models are explicitly illustrations; original Russian content and facts retain authority over the visual story. Local Golos fonts and vector geographic data supply the shipped assets; there are no shipping rasters.",
    "keyCharacteristics": [
      "Graphite and pale-paper sections with safety-orange actions.",
      "Self-hosted Cyrillic typography and generous editorial spacing.",
      "Procedural transport illustrations, with an empty-platform opening and closing.",
      "Native controls and readable content independent of WebGL."
    ],
    "rules": [
      {
        "name": "The Route Rule",
        "body": "Orange marks action and transport continuity rather than filling every surface.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do retain the original Russian facts and content order.",
      "Do use orange for actions, route geometry and meaningful selected states.",
      "Do keep forms and text usable when WebGL or animation is unavailable.",
      "Do preserve native field labels, keyboard focus and honest demo submission feedback."
    ],
    "donts": [
      "Don't introduce documentary claims through illustrative geometry.",
      "Don't replace the missing founder photo with an invented employee portrait.",
      "Don't claim CRM success when no endpoint is connected.",
      "Don't add decorative shadows to ordinary content sections."
    ]
  }
